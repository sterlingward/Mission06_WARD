@model List<JoelHiltonFilmCollection.Models.Movie>

@{
    ViewData["Title"] = "The Joel Hilton Film Collection";
}

<h2>The Joel Hilton Film Collection</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add New Movie</a>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>Copied to Plex</th>
        <th>Category</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Title</td>
            <td>@movie.Year</td>
            <td>@movie.Director</td>
            <td>@movie.Rating</td>
            <td>@(movie.Edited ? "Yes" : "No")</td>
            <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
            <td>@(movie.Category?.CategoryName ?? "None")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@movie.MovieId" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>