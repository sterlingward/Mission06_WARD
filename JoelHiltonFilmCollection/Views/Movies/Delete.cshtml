@model JoelHiltonFilmCollection.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h2>Delete Movie</h2>

<h3>Are you sure you want to delete this movie?</h3>
<div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>
        <dt class="col-sm-2">Year</dt>
        <dd class="col-sm-10">@Model.Year</dd>
        <dt class="col-sm-2">Director</dt>
        <dd class="col-sm-10">@Model.Director</dd>
        <dt class="col-sm-2">Rating</dt>
        <dd class="col-sm-10">@Model.Rating</dd>
        <dt class="col-sm-2">Edited</dt>
        <dd class="col-sm-10">@(Model.Edited ? "Yes" : "No")</dd>
        <dt class="col-sm-2">Copied to Plex</dt>
        <dd class="col-sm-10">@(Model.CopiedToPlex ? "Yes" : "No")</dd>
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@(Model.Category?.CategoryName ?? "None")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()  <!-- recommended -->
        <input type="hidden" asp-for="MovieId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>

</div>